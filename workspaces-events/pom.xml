<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-workspaces</artifactId>
        <version>2026.810.124125</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- qits-workspaces' event vocabulary: the things this service announces to the platform.
         Today exactly one, `SoftwareRelease`.

         A module of its own, between `eventstream` and everything else, for the reason qits-ci's
         `ci-events` gives: a vocabulary is what a CONSUMER needs, and nothing else in this repo is.
         A service that wants to listen for SoftwareRelease depends on this jar and gets the class
         plus the bus and no part of the workspaces domain.

         It depends on `eventstream` and on nothing else, not even quarkus-arc: these are plain
         records, and a data module that cannot boot a container cannot grow a service.

         `domain` deliberately does NOT depend on it. The domain stays bus-free — its seam is the
         `ReleaseAnnouncer` port, and `service` is what implements the port in terms of this class.
         Separately publishable one day, separately published explicitly out of scope now. -->
    <artifactId>qits-workspaces-events</artifactId>
    <name>qits-workspaces :: events</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-eventstream</artifactId>
        </dependency>
        <dependency>
            <!-- Plain JUnit 5, not quarkus-junit5: nothing here is a @QuarkusTest. The suite drives
                 plain constructors and the canonical serializer, which needs no container. -->
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
