<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben.qits</groupId>
        <artifactId>qits-workspaces</artifactId>
        <version>2026.809.185757</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The workspaces DOMAIN: entity, persistence, dto, mapper, control, and the framework-free
         SPIs the in-container workspace-daemon implements from the service side. Six of the
         monorepo's aggregates collapsed onto one package per layer: the workspace half of
         domain.repository, plus domain.service (host-side dev-server supervision), domain.bootstrap,
         domain.process, domain.capture and domain.workspace. A plain library
         jar in the shape of the monorepo's `artifacts`/`ci`/`epics` modules — NO web, NO JAX-RS,
         NO websockets; those live in the sibling `service` module.

         It owns its OWN named datasource + persistence unit + Flyway lineage (its own PostgreSQL
         database, provisioned by the platform's `resources:` mechanism — see
         src/main/resources/META-INF/microprofile-config.properties),
         and it references repositories by *String id*, never a JPA @ManyToOne into qits' tables.
         That is what makes this repo a standalone deployable rather than a checkout of the monorepo.

         Deliberately absent vs. the monorepo's `domain`: snakeyaml (that was QitsConfigParser, a
         duplicate of the daemon's own ConfigParser — the daemon owns config reading now) and pty4j
         (server-side PTY belongs to the command context). -->
    <artifactId>qits-workspaces-domain</artifactId>
    <name>qits-workspaces :: domain</name>

    <dependencies>
        <dependency>
            <!-- The git substrate. A plain library, so nothing in it is a bean and the one CDI
                 producer that builds it from config lives here, in `wiring`'s sibling. -->
            <groupId>${project.groupId}</groupId>
            <artifactId>qits-workspaces-gitmirror</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- ObjectMapper bean availability: the workspace metadata sidecars and the daemon's
                 ConfigView JSON are both read with it. No REST needed. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- This context's store. It was a file H2 until the platform grew resource
                 provisioning; the `workspaces` datasource is a PostgreSQL database of its own now,
                 created by qits-deployments before the container starts. -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <!-- Flyway 10 split its database support out of the core: without this module Flyway
                 refuses a postgres url with "no database found to handle". It sits here because
                 this module owns the lineage. -->
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-validator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- The store every @QuarkusTest here boots against. Zonky spawns real postgres binaries
                 as a child process — a maven dependency rather than a container — which is what
                 keeps the clone-alone, docker-free rule true now that the store is postgres.
                 EmbeddedPg + EmbeddedPgConfigSource hand the running instance to Quarkus. -->
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Named per architecture on purpose: the binaries are separate artifacts and zonky
                 picks one at run time, so an unnamed arch fails in the middle of a suite rather than
                 during resolution. These three are what this platform is built and developed on. -->
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-darwin-arm64v8</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- Index the jar so a consuming app discovers its CDI beans and entities without
                     needing a quarkus.index-dependency entry. -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
