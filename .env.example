# Local, per-machine overrides for running qits-workspaces outside a container.
#
# COPY THIS FILE to `.env` (same directory, drop the .example) and edit. `.env` is gitignored;
# this one is tracked, so the template survives and your machine's values never do.
#
# Quarkus reads `.env` from the process's WORKING DIRECTORY at config ordinal 295 — above the
# packaged src/main/resources/application.properties (250), below real environment variables (300)
# and `-D` system properties (400). So it overrides the shipped config without a rebuild and
# without touching a tracked file, and it works for the native binary exactly as for the fast-jar.
# Working directory means the repo root if you run:
#
#     ./service/target/qits-workspaces
#
# Keys are ENVIRONMENT VARIABLE names, not property names: uppercase, dots and dashes to
# underscores. That is the one cost of this file over a properties one — `quarkus.http.port` is
# spelled QUARKUS_HTTP_PORT here — and the payoff is that the same names work unchanged as real env
# vars in a container, which is where these services actually run.

# --- the one setting this service will not start without ----------------------------------------
# quarkus.rest-client.qits-projects.url derives from this. Where qits-projects answers: a workspace
# is a branch of a repository and this context holds no foreign key into the repositories tables,
# so with no registry to ask, the service fails closed at startup rather than 404ing every
# repository-scoped route. Scheme, host and port — NO path, because qits-projects serves its own
# /projects/api segment. In containers this becomes http://qits-projects:8080.
QITS_PROJECTS_URL=http://localhost:8090

# --- ports ---------------------------------------------------------------------------------------
# quarkus.http.port. 8080 is the shipped default and every service in the split claims it, so
# running more than one on a single host needs them separated. qits-projects' matching .env.example
# puts that service on 8090, which is what QITS_PROJECTS_URL above points at.
QUARKUS_HTTP_PORT=8091

# --- the shared on-disk contract ------------------------------------------------------------------
# qits.repositories.data-dir must resolve to the SAME tree in qits-projects, qits-workspaces and
# qits-artifacts, or this service branches from origins the others cannot see. Running everything as
# one user on one host already satisfies that (~/.qits/data/repositories); it is only worth setting
# if you deliberately want an isolated scratch tree — and then it has to be set in all three:
#
# QITS_REPOSITORIES_DATA_DIR=/tmp/qits-local/repositories
